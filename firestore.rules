rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['762926@profe.sed.sc.gov.br', 'samuel.faustino@aluno.unc.br'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrador')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // TEST CONNECTION
    match /test/{docId} {
      allow read: if true;
    }

    // PRODUCTS COLLECTION
    // Public read and validated catalog management
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isValidId(productId);
    }

    // CATEGORIES COLLECTION
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // COLLECTIONS COLLECTION
    match /collections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if isValidId(collectionId);
    }

    // BANNERS COLLECTION
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isValidId(bannerId);
    }

    // USERS COLLECTION
    // Clients can read only their own profile; clients cannot assign or change role to 'administrador'
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'cliente' || 
        (request.resource.data.role == 'administrador' && request.auth.token.email in ['762926@profe.sed.sc.gov.br', 'samuel.faustino@aluno.unc.br'])
      );
      allow update: if (isOwner(userId) && (
        request.resource.data.role == resource.data.role || isAdmin()
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // ORDERS COLLECTION
    // Clients can read own orders; create own order with 'pendente'; CANNOT edit status or delete orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(orderId) && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pendente'
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // CARTS COLLECTION
    // Each user has their own cart document matching their userId
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
